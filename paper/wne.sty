% Layout of a diploma thesis at the Faculty of Economic Sciences, University of Warsaw.
% Implements the formal requirements (Resolution no. 7 of the WNE Teaching Council, Załącznik B and D)
% as summarised in docs/wne-thesis-rules.md of the seminar repository. Check the official text.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wne}[2026/09/30 WNE UW diploma thesis layout]

% ---------------------------------------------------------------- page and type
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{newtxtext,newtxmath}              % Times-like, 12 pt set by the class option
\RequirePackage[a4paper,margin=25mm]{geometry}    % all margins 25 mm
\RequirePackage{setspace}
\onehalfspacing                                   % line spacing 1.5
\setlength{\parindent}{1cm}                       % paragraph indent 1 cm
\pagestyle{plain}                                 % page number bottom centre

% ---------------------------------------------------------------- headings
\RequirePackage{titlesec}
\titleformat{\chapter}{\normalfont\Large\bfseries}{\thechapter.}{0.6em}{}
\titlespacing*{\chapter}{0pt}{0pt}{18pt}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection.}{0.6em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection.}{0.6em}{}
\setcounter{secnumdepth}{2}                       % chapter, section, subsection
\setcounter{tocdepth}{2}                          % at most three levels in the contents

% ---------------------------------------------------------------- floats and sources
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage[font=footnotesize,labelfont=bf,skip=4pt]{caption}   % 10 pt captions
\counterwithout{figure}{chapter}                  % numbered through the whole thesis
\counterwithout{table}{chapter}
\counterwithout{equation}{chapter}
% Source line under every table and figure (10 pt): \source{own calculations based on Stooq data}
\newcommand{\source}[1]{\par\vspace{3pt}{\footnotesize Source: #1\par}}

% ---------------------------------------------------------------- citations
\RequirePackage[round,authoryear]{natbib}         % (Bollerslev, 1986)
\bibliographystyle{apalike}                       % alphabetical, unnumbered, APA-like

\RequirePackage{pdfpages}
\RequirePackage[hidelinks]{hyperref}

% ---------------------------------------------------------------- metadata
\newcommand{\thesistitle}[1]{\def\wne@title{#1}}
\newcommand{\thesistitleother}[1]{\def\wne@titleother{#1}}
\newcommand{\thesisauthor}[1]{\def\wne@author{#1}}
\newcommand{\albumnumber}[1]{\def\wne@album{#1}}
\newcommand{\thesiskind}[1]{\def\wne@kind{#1}}
\newcommand{\fieldofstudy}[1]{\def\wne@field{#1}}
\newcommand{\supervisor}[1]{\def\wne@supervisor{#1}}
\newcommand{\thesisplace}[1]{\def\wne@place{#1}}
\newcommand{\thesisabstract}[1]{\def\wne@abstract{#1}}
\newcommand{\thesiskeywords}[1]{\def\wne@keywords{#1}}
\newcommand{\thesiskeywordspl}[1]{\def\wne@keywordspl{#1}}
\newcommand{\erasmuscode}[1]{\def\wne@erasmus{#1}}
\newcommand{\subjectclassification}[1]{\def\wne@subject{#1}}
\thesistitleother{}\thesiskeywordspl{}\subjectclassification{}

% ---------------------------------------------------------------- front matter
% Title page: counted as page 0, number not printed.
\newcommand{\wnetitlepage}{%
  \setcounter{page}{0}%
  \begin{titlepage}
    \centering
    {\large University of Warsaw\par}
    {\large Faculty of Economic Sciences\par}
    \vspace{30mm}
    {\large \wne@author\par}
    {\normalsize Student number: \wne@album\par}
    \vspace{15mm}
    {\LARGE\bfseries \wne@title\par}
    \vspace{15mm}
    {\large \wne@kind\par}
    {\normalsize Field of study: \wne@field\par}
    \vfill
    \begin{flushright}
      \begin{minipage}{0.55\textwidth}
        The thesis written under the supervision of\\ \wne@supervisor
      \end{minipage}
    \end{flushright}
    \vspace{15mm}
    {\normalsize \wne@place\par}
  \end{titlepage}}

% Declarations: the signed faculty forms (supervisor, author, use of AI systems).
% Put the scan in declarations/declarations.pdf; until then a page lists what is required.
\newcommand{\wnedeclarations}{%
  \IfFileExists{declarations/declarations.pdf}{%
    \includepdf[pages=-,pagecommand={\thispagestyle{plain}}]{declarations/declarations.pdf}%
  }{%
    \chapter*{Declarations}
    This page is replaced by the scan of the signed faculty forms, saved as\\
    \texttt{declarations/declarations.pdf}:
    \begin{itemize}
      \item the supervisor's declaration,
      \item the author's declaration (for two authors: one per author, with their contribution per chapter),
      \item the declaration on the use of AI systems.
    \end{itemize}
    Current forms: \url{https://www.wne.uw.edu.pl/student/prace-dyplomowe}.
    \clearpage}}

% Abstract page.
\newcommand{\wneabstractpage}{%
  \chapter*{Abstract}
  \wne@abstract\par
  \bigskip
  \noindent\textbf{Keywords:} \wne@keywords
  \ifx\wne@keywordspl\@empty\else\ (\wne@keywordspl)\fi\par
  \medskip
  \noindent\textbf{Erasmus code:} \wne@erasmus\par
  \ifx\wne@subject\@empty\else
    \medskip\noindent\textbf{Subject classification:} \wne@subject\par\fi
  \ifx\wne@titleother\@empty\else
    \medskip\noindent\textbf{Title in Polish:} \wne@titleother\par\fi
  \clearpage}

% Part-like separator page, used by the article form ("Scientific article", "Supplement").
\newcommand{\wneseparator}[1]{%
  \clearpage\thispagestyle{plain}\null\vfill
  \begin{center}{\LARGE\bfseries #1\par}\end{center}
  \vfill\clearpage}

\endinput
